---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Aresyn" description="That page does not exist. Here are the places people usually want." path="/404" noindex={true}>
  <section class="page-header"><div class="container"><span class="eyebrow">404</span><h1>That page does not exist.</h1><p class="lead">The link may be old. These are the pages people usually want.</p></div></section>
  <section class="section"><div class="container"><div class="grid grid-4">
    <a href="/services" class="card card-flat"><h3>Services</h3><span class="card-link">View</span></a>
    <a href="/industries" class="card card-flat"><h3>Industries</h3><span class="card-link">View</span></a>
    <a href="/work" class="card card-flat"><h3>Work</h3><span class="card-link">View</span></a>
    <a href="/contact" class="card card-flat"><h3>Contact</h3><span class="card-link">View</span></a>
  </div></div></section>
</Base>
