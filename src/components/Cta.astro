---
import { site } from '../data/site';
interface Props { title?: string; body?: string; primary?: { href: string; label: string }; secondary?: { href: string; label: string } }
const {
  title = 'Tell us what you need built.',
  body = `Send a short description of what you need and we reply ${site.responseTime}. No sales sequence, just a conversation with the person who would build it.`,
  primary = { href: '/contact', label: 'Start a project' },
  secondary = { href: '/work', label: 'See our work' },
} = Astro.props;
---
<section class="section-sm">
  <div class="container">
    <div class="cta-band fade-up">
      <div>
        <h2>{title}</h2>
        <p>{body}</p>
      </div>
      <div class="btn-group">
        <a href={primary.href} class="btn">{primary.label}</a>
        {secondary && <a href={secondary.href} class="btn btn-outline">{secondary.label}</a>}
      </div>
    </div>
  </div>
</section>
