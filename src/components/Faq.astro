---
interface Props { faqs: { q: string; a: string }[]; title?: string; eyebrow?: string }
const { faqs, title = 'Frequently asked questions', eyebrow = 'FAQ' } = Astro.props;
---
<section class="section-sm" aria-labelledby="faq-heading">
  <div class="container-narrow">
    <span class="eyebrow">{eyebrow}</span>
    <h2 id="faq-heading" class="mb-3">{title}</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="faq-a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
